{
	"name": "@effect-motion/renderer",
	"version": "0.8.0",
	"description": "Retained three.js frame renderer for effect-motion",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/julia-script/effect-motion.git",
		"directory": "packages/renderer"
	},
	"homepage": "https://github.com/julia-script/effect-motion#readme",
	"bugs": "https://github.com/julia-script/effect-motion/issues",
	"keywords": [
		"effect",
		"motion",
		"renderer",
		"three",
		"webgpu",
		"motion-graphics"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest run --passWithNoTests",
		"visual:masks:browser": "bun build test/visual-mask-matrix/browser.ts --target browser --outdir test/visual-mask-matrix --external module --external '*.wasm' && cp node_modules/@text-rendering-toolkit/font/dist/internal/vendor/harfbuzz.wasm test/visual-mask-matrix/harfbuzz.wasm",
		"visual:masks:node": "bun test/visual-mask-matrix/node.ts",
		"check": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@effect-motion/three": "workspace:^",
		"@effect/platform-node": "4.0.0-rc.115",
		"@text-rendering-toolkit/font": "^0.3.0",
		"@text-rendering-toolkit/layout": "^0.3.0",
		"@text-rendering-toolkit/three-webgpu": "^0.3.0",
		"@types/three": "^0.185.1",
		"effect-motion": "workspace:^",
		"jpeg-js": "^0.4.4",
		"pngjs": "^7.0.0",
		"three": "^0.185.1"
	},
	"peerDependencies": {
		"effect": ">=4.0.0-rc.115"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/pngjs": "^6.0.5",
		"effect": "4.0.0-rc.115",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
